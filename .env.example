# --- required ---------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FORAGER_API_KEY=your_forager_api_key
FORAGER_ACCOUNT_ID=2845

# --- optional: webhook signature verification -------------------------
# Private app client secret. When set, every webhook must carry a valid
# X-HubSpot-Signature-v3 header or it is rejected with 401.
HUBSPOT_CLIENT_SECRET=

# --- contact discovery -----------------------------------------------
# Titles that count as "relevant decision makers" (comma separated).
TARGET_TITLES=ceo,cto,cmo,coo,cro,cfo,founder,co-founder,owner,president,vice president,vp,head,director,chief,partner,principal,manager
# Optional: override the boolean query sent to Forager's role search.
# TARGET_TITLE_QUERY="Head OR Director OR VP OR Chief OR Founder"
MAX_CONTACTS_PER_COMPANY=5
DISCOVER_CONTACTS=true
ENRICH_EXISTING_CONTACTS=true
ENSURE_CONTACT_COMPANY=true

# --- contact channels -------------------------------------------------
ENABLE_WORK_EMAIL_LOOKUP=true
ENABLE_PHONE_LOOKUP=true
# highest_quality (default, strictest verification) or most_coverage
PHONE_QUALITY_TIER=highest_quality
WORK_EMAIL_POLL_SECONDS=2
WORK_EMAIL_TIMEOUT_SECONDS=60

# --- safety rails -----------------------------------------------------
AUTO_CREATE_PROPERTIES=true
VERIFY_WEBHOOK_SIGNATURES=true
SKIP_ALREADY_ENRICHED=true
# 0 = no local cap. Set e.g. 150 to hard-stop lookups after an estimated
# credit spend, as a guard on a free Forager plan.
CREDIT_BUDGET=0
HTTP_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
